<div class="card">
  <div class="card-body">
    <form class="forms-sample" onsubmit="return catogoryupdate(event)" data-id="<%= category ? category._id : '' %>">
      <div class="form-group">
        <input id="id" type="hidden" name="id" value="<%= category ? category._id : '' %>" />
        <label for="exampleInputName1">Name</label>
        <input name="name" type="text" class="form-control" id="updatename" placeholder="Name" value="<%= category ? category.name : '' %>" >
        <small id="nameError" class="text-danger" style="display: none;">Name is required</small>
        <p id="errorcatognameupdate" class="text-danger" style="display: none;"></p>
      </div>
      <div class="form-group">
        <label for="exampleInputName1">Description</label>
        <textarea class="form-control" id="descr" name="description" rows="3"><%= category ? category.descr : '' %></textarea>
        <small id="descError" class="text-danger" style="display: none;">Description is required</small>
      </div>
      
      <button type="submit" class="btn btn-primary mr-2">Submit</button>
    </form>
  </div>
</div>