<div class="card">
  <div class="card-body">
    <form class="forms-sample" onsubmit="return catogoryadder(event)">
      <div class="form-group">
        <label for="exampleInputName1">Name of category</label>
        <input name="name" type="text" class="form-control" id="updatename" placeholder="Name">
        <small id="nameError" class="text-danger" style="display: none;">Name is required</small>
      </div>
      <div class="form-group">
        <label for="exampleInputName1">Description</label>
        <textarea class="form-control" id="descr" name="description" rows="3"></textarea>
        <small id="descError" class="text-danger" style="display: none;">Description is required</small>
      </div>
      <div class="form-group">
        <label for="offerInput">Category Offer (%)</label>
        <input
          type="number"
          class="form-control"
          id="offerInput"
          name="offer"
          placeholder="Enter discount percentage"
          min="0"
          max="100"
        />
        <small class="text-muted">Leave empty or 0 for no category offer.</small>
      </div>
      <button type="submit" class="btn btn-primary mr-2">Submit</button>
    </form>
  </div>
</div>